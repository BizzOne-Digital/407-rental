# ═══════════════════════════════════════════════════════════════════════════
# 407 Auto Rentals — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════

# ─── Supabase (required for admin panel) ─────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# supabase_password = ?9gK*3N/6eiM-a8
# ─── Form submissions (optional) ─────────────────────────────────────────
# If not set, uses the email from admin panel / defaults
# VITE_RECIPIENT_EMAIL=407autorentals@gmail.com
